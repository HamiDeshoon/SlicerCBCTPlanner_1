+    draw.rectangle([24, 20, W - 24, 88], fill=(15, 23, 42))
+    draw.text((42, 32), header_txt, fill=(248, 250, 252), font=font)
+    draw.text((42, 58), legend_txt, fill=(148, 163, 184), font=font)
+
+    # Panoramic Strip (top)
+    pano_box = (24, 100, W - 24, 580)
