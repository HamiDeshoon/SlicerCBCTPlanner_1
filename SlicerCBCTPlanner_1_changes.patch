+        p_img = Image.fromarray(p_u8, mode="L").convert("RGB").resize((pw - 4, ph - 4))
+        page.paste(p_img, (pano_box[0] + 2, pano_box[1] + 2))
+
+    # Draw numbered vertical cut lines (#1..#N) on panoramic
+    arc_denom = max(1.0, float(total_arc_mm))
+    for idx, item in enumerate(cross_sections):
+        arc_pos = float(item.get("arc_mm", 0.0))
