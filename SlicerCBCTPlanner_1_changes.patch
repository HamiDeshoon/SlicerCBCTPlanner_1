+def generate_print_layout_10x8(
+    out_dir: Path,
+    pano_array: Optional[np.ndarray],
+    cross_sections: Sequence[Dict[str, Any]],
+    quadrant: int,
+    selected_fdis: Sequence[int],
+    vr_image: Optional[Any] = None,
+    vr_classes_label: str = "",
