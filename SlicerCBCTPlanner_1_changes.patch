+"""Unit tests for S-I flip sync, arch fitting, panoramic optimization, and 10x8" print layout."""
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1] / "CBCTPlanner"
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from CBCTPlannerLib.core.volume_loader import CBCTVolume, flip_array_si
+from CBCTPlannerLib.core.arch_detector import DentalArch, fit_dental_arch_from_points
+from CBCTPlannerLib.PanoramicCurveLogic import PanoramicCurveLogic
+from CBCTPlannerLib.AdvancedTools import (
+    generate_print_layout_10x8,
+    render_cross_section_pil,
+    render_headless_quadrant_vr_pil,
+)
+
+
+class TestSlicerCBCTPlannerEnhancements(unittest.TestCase):
+    def test_flip_array_si_preserves_volume_mask_alignment(self):
+        vol = np.zeros((16, 12, 12), dtype=np.float32)
+        mask = np.zeros((16, 12, 12), dtype=np.uint8)
+        vol[2, 5, 6] = 1200.0
+        mask[2, 5, 6] = 46
+
+        vol_f = flip_array_si(vol)
+        mask_f = flip_array_si(mask)
+
+        self.assertEqual(vol_f[13, 5, 6], 1200.0)
+        self.assertEqual(mask_f[13, 5, 6], 46)
+        self.assertTrue(np.array_equal(np.argwhere(vol_f > 0), np.argwhere(mask_f > 0)))
+
+    def test_arch_fitting_asymmetric_u_shaped_without_self_crossing(self):
+        # Asymmetric U-shaped arch: full right side + anterior, missing left posterior
+        angles = np.linspace(0.05 * np.pi, 0.72 * np.pi, 14)
+        x = 28.0 * np.cos(angles)
+        y = 32.0 * np.sin(angles)
+        z = np.full_like(x, 12.0)
+        pts = np.column_stack([x, y, z])
+
+        ctrl = fit_dental_arch_from_points(pts, jaw_type="lower", num_control_points=11, ras_convention=True)
+        self.assertEqual(ctrl.shape, (11, 3))
+        # Must progress monotonically from Patient Right (+X) to Patient Left (-X)
+        self.assertGreater(ctrl[0, 0], ctrl[-1, 0])
+        # Check no self-crossing / huge backward jumps
+        arch = DentalArch(ctrl, jaw_type="lower", ras_convention=True)
+        self.assertGreater(arch.total_arc_length, 40.0)
+
+    def test_panoramic_slab_fast_resampling_and_10x8_print_layout(self):
+        img = np.full((32, 48, 48), -800.0, dtype=np.float32)
+        # Put a high-density bone horseshoe in the middle
+        img[10:22, 18:34, 12:36] = 900.0
+        aff = np.eye(4, dtype=np.float64); aff[:3, 3] = [-24.0, -24.0, -16.0]
+        vol = CBCTVolume(image=img, spacing=(1.0, 1.0, 1.0), origin=(-24.0, -24.0, -16.0), direction=np.eye(3, dtype=np.float64), affine=aff)
+
+        ctrl = np.array([
+            [14.0, -4.0, 0.0],
+            [10.0, 6.0, 0.0],
+            [0.0, 10.0, 0.0],
+            [-10.0, 6.0, 0.0],
+            [-14.0, -4.0, 0.0],
+        ], dtype=np.float64)
+        arch = DentalArch(ctrl, jaw_type="lower", ras_convention=True)
+        frames = arch.sample_frames_uniform(step_mm=2.0)
+        pts = np.array([f.point for f in frames])
+        T = np.array([f.tangent for f in frames])
+        N = np.array([f.normal for f in frames])
+        B = np.array([f.binormal for f in frames])
+
+        pano = PanoramicCurveLogic.sample_panoramic_slab_array(
+            vol, pts, T, N, B, slab_thickness_mm=10.0, height_mm=24.0, spacing_mm=1.0
+        )
+        self.assertEqual(pano.ndim, 2)
+        self.assertGreater(float(np.max(pano)), 0.0)
+
+        # Render 15 real cross-sections and generate 10x8" (3000x2400) PNG + PDF
+        series = []
+        for idx, arc_mm in enumerate(np.linspace(5.0, arch.total_arc_length - 5.0, 15)):
+            tile = render_cross_section_pil(
+                pano[:, :20],
+                height_mm=14.2,
+                w_crest_mm=6.1,
+                w_3mm=7.4,
+                w_5mm=8.2,
+                nerve_clearance_mm=12.0,
+            )
+            series.append({
+                "arc_mm": float(arc_mm),
+                "height_mm": "14.2",
+                "w_crest_mm": "6.1",
+                "w_3mm": "7.4",
+                "w_5mm": "8.2",
+                "pil_image": tile,
+            })
+
+        vr_img = render_headless_quadrant_vr_pil(vol, quadrant=4)
+        with tempfile.TemporaryDirectory() as tmpdir:
+            png_path, pdf_path = generate_print_layout_10x8(
+                out_dir=Path(tmpdir),
+                pano_array=pano,
+                cross_sections=series,
+                quadrant=4,
+                selected_fdis=[46],
+                vr_image=vr_img,
+                total_arc_mm=arch.total_arc_length,
+            )
+            self.assertTrue(png_path.exists())
+            self.assertTrue(pdf_path.exists())
+            from PIL import Image
+            with Image.open(png_path) as im:
+                self.assertEqual(im.size, (3000, 2400))
+
+
+if __name__ == "__main__":
+    unittest.main()
