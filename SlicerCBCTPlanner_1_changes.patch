+def _window_to_uint8(arr_2d: np.ndarray, wl: float = 500.0, ww: float = 2500.0) -> np.ndarray:
+    """Map 2D CBCT HU/intensity slice to uint8 [0, 255] with adaptive fallback for uncalibrated scans."""
+    a = np.asarray(arr_2d, dtype=np.float64)
+    if a.size == 0:
+        return np.zeros((1, 1), dtype=np.uint8)
+    lo_p, hi_p = float(np.percentile(a, 2)), float(np.percentile(a, 99.5))
+    if hi_p - lo_p < 50.0 or (lo_p >= 0.0 and hi_p <= 4096.0 and lo_p > -200.0):
+        lo, hi = lo_p, max(lo_p + 1.0, hi_p)
+    else:
+        lo, hi = wl - 0.5 * ww, wl + 0.5 * ww
+    norm = np.clip((a - lo) / max(1e-6, hi - lo), 0.0, 1.0)
+    return (norm * 255.0).astype(np.uint8)
+
+
+def render_cross_section_pil(
+    slice_2d: np.ndarray,
+    fov_width_mm: float = 30.0,
+    fov_height_mm: float = 36.0,
+    height_mm: Optional[float] = None,
+    w_crest_mm: Optional[float] = None,
+    w_3mm: Optional[float] = None,
+    w_5mm: Optional[float] = None,
+    nerve_clearance_mm: Optional[float] = None,
+    out_size: Tuple[int, int] = (240, 288),
+) -> Any:
+    """Render a real resampled 2D CBCT cross-section with calibrated measurement lines using PIL."""
+    from PIL import Image, ImageDraw  # type: ignore
+
+    u8 = _window_to_uint8(slice_2d)
+    # Row 0 is inferior (-B), flip vertically so superior (+B) is at top of image
+    u8_disp = u8[::-1, :]
+    img = Image.fromarray(u8_disp, mode="L").convert("RGB").resize(out_size)
+    draw = ImageDraw.Draw(img)
+
+    w_px, h_px = out_size
+    cx = w_px // 2
+    px_per_mm_x = w_px / max(1.0, float(fov_width_mm))
+    px_per_mm_y = h_px / max(1.0, float(fov_height_mm))
+
+    # Crest anchor near upper-third center
+    crest_y = int(round(h_px * 0.28))
+
+    if height_mm is not None and height_mm > 0:
+        end_y = min(h_px - 8, crest_y + int(round(height_mm * px_per_mm_y)))
+        draw.line([(cx, crest_y), (cx, end_y)], fill=(34, 197, 94), width=3)  # Green: Ridge Height
+        draw.line([(cx - 6, crest_y), (cx + 6, crest_y)], fill=(34, 197, 94), width=2)
+        draw.line([(cx - 6, end_y), (cx + 6, end_y)], fill=(34, 197, 94), width=2)
+
+    if w_crest_mm is not None and w_crest_mm > 0:
+        hw = int(round(0.5 * w_crest_mm * px_per_mm_x))
+        draw.line([(cx - hw, crest_y), (cx + hw, crest_y)], fill=(234, 179, 8), width=3)  # Gold: Crest W0
+
+    if w_3mm is not None and w_3mm > 0:
+        y3 = min(h_px - 10, crest_y + int(round(3.0 * px_per_mm_y)))
+        hw3 = int(round(0.5 * w_3mm * px_per_mm_x))
+        draw.line([(cx - hw3, y3), (cx + hw3, y3)], fill=(6, 182, 212), width=2)  # Cyan: W@3mm
+
+    if w_5mm is not None and w_5mm > 0:
+        y5 = min(h_px - 8, crest_y + int(round(5.0 * px_per_mm_y)))
+        hw5 = int(round(0.5 * w_5mm * px_per_mm_x))
+        draw.line([(cx - hw5, y5), (cx + hw5, y5)], fill=(59, 130, 246), width=2)  # Blue: W@5mm
+
+    if nerve_clearance_mm is not None and nerve_clearance_mm > 0:
+        yn = min(h_px - 10, crest_y + int(round(nerve_clearance_mm * px_per_mm_y)))
+        r = 7
+        draw.ellipse([(cx - r, yn - r), (cx + r, yn + r)], outline=(239, 68, 68), width=2)
+
+    return img
+
+
+def render_headless_quadrant_vr_pil(
+    cbct_volume: Any,
+    quadrant: int = 4,
+    out_size: Tuple[int, int] = (720, 420),
+) -> Any:
+    """Generate a clean 3D-like anterior-buccal MIP projection for a quadrant when Slicer GUI is absent."""
+    from PIL import Image  # type: ignore
+
+    arr = np.asarray(cbct_volume.image, dtype=np.float32)
+    z_dim, y_dim, x_dim = arr.shape
+    z0, z1 = (z_dim // 2, z_dim) if int(quadrant) in (1, 2) else (0, max(1, z_dim // 2))
+    # Patient Right (Q1/Q4) is +X (or lower/upper half depending on affine); take MIP along Y
+    sub = arr[z0:z1, :, :]
+    mip = np.max(sub, axis=1)[::-1, :]
+    u8 = _window_to_uint8(mip, wl=600.0, ww=2200.0)
+    return Image.fromarray(u8, mode="L").convert("RGB").resize(out_size)
+
